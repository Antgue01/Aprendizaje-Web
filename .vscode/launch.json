{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [

        
        
        {
            "type": "chrome",
            "name": "Launch Chrome against localhost",
            "pathMapping": {
                "/": "${workspaceFolder}"
            },
            "url": "http://localhost:5502/${relativeFileDirname}/index.html",
            "request": "launch",
            "webRoot": "${workspaceFolder}"
        },
        {
            "type": "chrome",
            "name": "Launch JS notes",
            "pathMapping": {
                "/": "${workspaceFolder}"
            },
            "url": "http://localhost:5502/${relativeFileDirname}/JS.html",
            "request": "launch",
            "webRoot": "${workspaceFolder}"
        }
    ]
}